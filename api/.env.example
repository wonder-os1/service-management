# Database
DATABASE_URL="postgresql://user:password@localhost:5432/service_hub?schema=public"

# JWT
JWT_SECRET="your-secret-key-change-in-production"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_IN="30d"

# App
PORT=4000
NODE_ENV=development
APP_NAME="Service Business Hub"
APP_URL="http://localhost:3000"
API_URL="http://localhost:4000"

# Razorpay
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Email (Resend)
RESEND_API_KEY=""
EMAIL_FROM="noreply@wonderos.in"

# Business Config
BUSINESS_CURRENCY="INR"
BUSINESS_TIMEZONE="Asia/Kolkata"
BUSINESS_HOURS_START="09:00"
BUSINESS_HOURS_END="21:00"
BUSINESS_SLOT_DURATION=30
LOYALTY_POINTS_PER_100=10
GST_RATE=0.18

# File Uploads
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=10485760

# Feature Flags (alternative to features.json)
FEATURE_ONLINE_BOOKING=false
FEATURE_LOYALTY_PROGRAM=false
FEATURE_SMS_NOTIFICATIONS=false
FEATURE_WHATSAPP_AUTOMATION=false
FEATURE_AI_CHATBOT=false
FEATURE_ADVANCED_ANALYTICS=false
FEATURE_MULTI_LOCATION=false
FEATURE_INVENTORY_MANAGEMENT=false
